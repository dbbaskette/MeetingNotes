<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Standard Electron hardened-runtime allowances. JIT + unsigned exec
         memory are needed by V8; library validation is disabled so the helper
         binary (signed by us, not Apple) can load alongside Electron's own
         frameworks. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Audio-capture entitlements. These are what TCC checks when our bundled
         meeting-notes-tap helper asks CoreAudio for a Process Tap or for the
         microphone. macOS attributes the request to MeetingNotes.app, so the
         entitlements must live on the parent here, not just on the helper. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
