# The remote-service image is built from the repository root because it shares
# one contract and one prompt module with the desktop. Keep the Docker daemon's
# build context to that explicit set; local libraries, dependencies, caches and
# environment files must never be sent merely because they exist on the host.
*
!server/
server/*
!server/.npmrc
!server/package.json
!server/package-lock.json
!server/tsconfig.json
!server/src/
!server/src/**
!server/tests/
!server/tests/**
!server/scripts/
!server/scripts/**
!server/migrations/
!server/migrations/**
!server/python/
!server/python/**
!shared/
shared/*
!shared/remote-contracts.ts
!electron/
electron/*
!electron/main/
electron/main/*
!electron/main/pipeline/
electron/main/pipeline/*
!electron/main/pipeline/prompts.ts
